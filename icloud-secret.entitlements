<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- "TEAMID" is replaced with the real Apple Team ID at build time. The
     keychain-access-group + application-identifier must match the App ID
     registered in the Apple Developer portal and the embedded provisioning
     profile, or SecItem* returns errSecMissingEntitlement (-34018). -->
<plist version="1.0">
<dict>
    <key>com.apple.application-identifier</key>
    <string>TEAMID.com.carterscode.icloudsecret</string>
    <key>keychain-access-groups</key>
    <array>
        <string>TEAMID.com.carterscode.icloudsecret</string>
    </array>
</dict>
</plist>
